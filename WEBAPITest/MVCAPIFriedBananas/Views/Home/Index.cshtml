@{
    ViewData["Title"] = "Bem-vindo ao BarEscola";
}

@section Styles {
    <style>
        .home-hero {
            position: relative;
            width: 100%;
            min-height: 60vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 1.25rem;
            margin-top: 2rem;
            box-shadow: 0 0.375rem 1.25rem rgba(16,24,40,0.08);
        }

        .home-hero-bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: blur(12px) brightness(0.7);
            z-index: 1;
        }

        .home-hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: var(--p-text, var(--text));
            width: 100%;
            max-width: 32rem;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

            .home-hero-content h1 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 1rem;
                color: var(--p-text, var(--text));
                text-shadow: 0 2px 16px rgba(0,0,0,0.12);
            }

            .home-hero-content p {
                font-size: 1.25rem;
                color: var(--p-muted, var(--text-muted));
                margin-bottom: 2rem;
                text-shadow: 0 2px 16px rgba(0,0,0,0.10);
            }

        .home-hero-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

            .home-hero-actions .btn {
                min-width: 8rem;
                max-width: 14rem;
                font-size: 1rem;
                padding: 0.75rem 1.5rem;
                border-radius: 0.625rem;
                font-weight: 700;
                box-shadow: 0 0.375rem 1.25rem rgba(16,24,40,0.08);
                transition: filter 120ms;
            }

            .home-hero-actions .btn-primary {
                background: var(--p-accent, var(--brand));
                color: #fff;
                border: none;
            }

                .home-hero-actions .btn-primary:hover {
                    filter: brightness(0.94);
                }

            .home-hero-actions .btn-ghost {
                background: transparent;
                border: 0.0625rem solid var(--p-border, var(--btn-contrast-border));
                color: var(--p-text, var(--btn-contrast));
            }

                .home-hero-actions .btn-ghost:hover {
                    border-color: var(--p-accent, var(--brand));
                    color: var(--p-accent, var(--brand));
                }

        /* Responsive styles */
        media (max-width: 600px) {
            .home-hero-content h1

        {
            font-size: 1.5rem;
        }

        .home-hero-content p {
            font-size: 1rem;
        }

        }</style>
}

<div class="home-hero">
    <img class="home-hero-bg" src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80" alt="BarEscola background" />
    <div class="home-hero-content">
        <h1>Bem-vindo ao BarEscola</h1>
        <p>Descubra os nossos produtos frescos e menus especiais.<br>Escolha o que deseja explorar!</p>
        <div class="home-hero-actions">
            <a class="btn btn-primary" href="@Url.Action("Index", "Products")">Ver Produtos</a>
            <a class="btn btn-ghost" href="@Url.Action("Index", "Menu")">Ver Menus</a>
        </div>
    </div>
</div>

