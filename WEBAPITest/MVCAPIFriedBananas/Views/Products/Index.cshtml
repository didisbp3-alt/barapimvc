@model MVCAPIFriedBananas.Views.ViewModels.ProductsPageViewModel
@using System.Security.Claims

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" />
}

<div class="products-page">
    <section class="hero">
        <div class="hero-text">
            <h1>Explore produtos e novidades.</h1>
            <p>Filtre por categoria, alergénios, preço e adicione aos favoritos.</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="@Url.Action("Highlights", "Products")">⭐ Destaques</a>
                <a class="btn btn-ghost" href="@Url.Action("Index", "Menu")">Ver menus</a>
            </div>
            <div class="hero-stats">
                <div class="stat-chip"><span class="dot"></span> Itens frescos hoje</div>
                <div class="stat-chip"><span class="dot"></span> Entrega rápida</div>
            </div>
        </div>
        <div class="hero-card">
            @{
                var highlight = Model.Items?.FirstOrDefault();
                string catName(object? catId, string? name) => !string.IsNullOrWhiteSpace(name) ? name : $"Categoria {catId}";
            }
            @if (highlight != null)
            {
                <div class="card highlight-card">
                    <div class="meta">
                        <strong class="accent">@catName(highlight.Cat_Id, highlight.CategoryName)</strong>
                        <span class="price">@highlight.Price.ToString("C")</span>
                    </div>
                    <h3>@highlight.Name</h3>
                    <p class="muted">@highlight.Description</p>
                    <div class="row gap-1">
                        <button type="button"
                                class="btn btn-primary btn-small"
                                data-add-cart
                                data-product-id="@highlight.ProdId">
                            🛒 Adicionar
                        </button>
                        <a class="btn btn-ghost btn-small" href="@Url.Action("Details", "Products", new { id = highlight.ProdId })">Detalhes</a>
                    </div>
                </div>
            }
        </div>
    </section>

    @{
        var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
        bool isStaff = userRole == "0" || userRole == "1";
    }
    @if (isStaff)
    {
        <div class="admin-toolbar">
            <span class="admin-toolbar-label">⚙️ Gestão</span>
            <a class="btn btn-primary btn-small" href="@Url.Action("AdminIndex", "Products")">📦 Gerir Produtos</a>
            <a class="btn btn-ghost btn-small" href="@Url.Action("AdminIndex", "Categories")">🏷️ Gerir Categorias</a>
        </div>
    }

    <form id="filtersForm" class="filters-bar">
        <div class="search-box">
            <span class="icon">🔍</span>
            <input type="text" name="Search" value="@Model.Search" placeholder="Procurar produtos..." />
        </div>

        <div class="select-box">
            <label>Categoria</label>
            <select name="SelectedCategory">
                <option value="">Todas</option>
                @foreach (var c in Model.Categories ?? Enumerable.Empty<string>())
                {
                    <option value="@c" selected="@(c == Model.SelectedCategory)">@c</option>
                }
            </select>
        </div>

        <div class="select-box">
            <label>Alergénios</label>
            <select name="SelectedAllergen">
                <option value="">Qualquer</option>
                @foreach (var a in Model.Allergens ?? Enumerable.Empty<string>())
                {
                    <option value="@a" selected="@(a == Model.SelectedAllergen)">@a</option>
                }
            </select>
        </div>

        <div class="select-box">
            <label>Preço</label>
            <select name="PriceRange">
                <option value="" selected="@(string.IsNullOrEmpty(Model.PriceRange))">Todos</option>
                <option value="lt5" selected="@(Model.PriceRange == "lt5")">&lt; €5</option>
                <option value="5to10" selected="@(Model.PriceRange == "5to10")">€5 – €10</option>
                <option value="gt10" selected="@(Model.PriceRange == "gt10")">&gt; €10</option>
            </select>
        </div>

        <div style="display:flex;align-items:flex-end;gap:0.4rem;">
            <label class="fav-filter-label @(Model.FavoritesOnly ? "active" : "")">
                <input type="checkbox" name="FavoritesOnly" value="true" @(Model.FavoritesOnly ? "checked" : "") onchange="this.form.submit()" style="display:none;" />
                ❤️ Favoritos
            </label>
        </div>

        <button class="btn btn-primary btn-small" type="submit">Filtrar</button>
        <button class="btn btn-ghost btn-small" type="button" id="clearFilters">Limpar</button>
    </form>

    <div id="productsList">
        @await Html.PartialAsync("_ProductCard", Model.Items)
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('meta[name="request-verification-token"]')?.content;
        const isLoggedIn = @Json.Serialize(User.Identity?.IsAuthenticated ?? false);
        const toggleFavUrl = '@Url.Action("ToggleFavorite", "Products")';
        const addCartUrl = '@Url.Action("Add", "Cart")';

        // ── Cart ─────────────────────────────────────────────────────────
        async function postCart(productId) {
            if (!isLoggedIn) { window.location.href = '/Auth/Login'; return; }

            const params = new URLSearchParams();
            params.append('id', productId);
            params.append('qty', 1);
            if (token) params.append('__RequestVerificationToken', token);

            const res = await fetch(addCartUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: params.toString()
            });
            if (res.status === 401 || res.redirected) { window.location.href = '/Auth/Login'; return; }
            if (!res.ok) throw new Error('Erro ao adicionar ao carrinho');
            const json = await res.json().catch(() => ({}));
            const badge = document.querySelector('[data-cart-count]');
            if (badge && json?.cartCount !== undefined) badge.textContent = json.cartCount;
        }

        function wireCartButtons(root = document) {
            root.querySelectorAll('[data-add-cart]').forEach(btn => {
                btn.onclick = async () => {
                    const id = btn.getAttribute('data-product-id');
                    const orig = btn.textContent;
                    btn.disabled = true; btn.textContent = '...';
                    try {
                        await postCart(id);
                        btn.textContent = '✓ Adicionado';
                        btn.style.background = '#22c55e';
                        setTimeout(() => { btn.textContent = orig; btn.style.background = ''; btn.disabled = false; }, 1500);
                    } catch (e) {
                        console.error(e); btn.textContent = orig; btn.disabled = false;
                        alert('Não foi possível adicionar ao carrinho.');
                    }
                };
            });
        }

        // ── Favorites ────────────────────────────────────────────────────
        async function toggleFav(productId) {
            const params = new URLSearchParams();
            params.append('id', productId);
            if (token) params.append('__RequestVerificationToken', token);

            const res = await fetch(toggleFavUrl + '/' + productId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: params.toString()
            });
            if (!res.ok) throw new Error('Erro ao guardar favorito');
            return await res.json();
        }

        function wireFavButtons(root = document) {
            root.querySelectorAll('[data-fav-toggle]').forEach(btn => {
                btn.onclick = async () => {
                    const id = btn.getAttribute('data-product-id');
                    try {
                        const data = await toggleFav(id);
                        btn.classList.toggle('active', data.isFavorite);
                        btn.textContent = data.isFavorite ? '♥' : '♡';
                    } catch (e) {
                        console.error(e);
                    }
                };
            });
        }

        // ── AJAX product filter ──────────────────────────────────────────
        async function fetchProducts(queryString) {
            const res = await fetch('@Url.Action("Filter", "Products")' + queryString, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!res.ok) throw new Error('Erro ao filtrar');
            const html = await res.text();
            const container = document.getElementById('productsList');
            container.innerHTML = html;
            wireCartButtons(container);
            wireFavButtons(container);
        }

        document.getElementById('filtersForm').addEventListener('submit', e => {
            e.preventDefault();
            const params = new URLSearchParams(new FormData(e.target)).toString();
            fetchProducts('?' + params).catch(err => console.error(err));
        });

        document.getElementById('clearFilters').addEventListener('click', () => {
            document.getElementById('filtersForm').reset();
            fetchProducts('').catch(err => console.error(err));
        });

        wireCartButtons();
        wireFavButtons();
    </script>
    <style>
        .fav-filter-label {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            height: 2.5rem;
            padding: 0 0.875rem;
            border-radius: 0.625rem;
            border: 1.5px solid var(--p-border);
            background: transparent;
            color: var(--p-muted);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 180ms ease;
            user-select: none;
        }
        .fav-filter-label:hover,
        .fav-filter-label.active {
            border-color: #e87600;
            color: #e87600;
            background: rgba(232,118,0,0.08);
        }
    </style>
}
