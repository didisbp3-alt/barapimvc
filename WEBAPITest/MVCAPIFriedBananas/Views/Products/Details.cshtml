@model MVCAPIFriedBananas.Views.ViewModels.ProductsViewModel
@{
    ViewData["Title"] = Model.Name ?? "Produto";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("pt-PT");
}

<div class="container my-4">
    <a asp-action="Index" class="btn btn-link text-decoration-none mb-3">
        <i class="fas fa-arrow-left me-1"></i> Voltar à lista
    </a>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="ratio ratio-4x3">
                    <img src="@(Model.ImageUrl ?? "/images/products/default.jpg")"
                         alt="@Model.Name"
                         class="card-img-top object-fit-cover"
                         onerror="this.onerror=null;this.src='/images/products/default.jpg';">
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <h2 class="fw-bold mb-2">@Model.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted">@Model.Description</p>
                    }

                    <div class="mb-3">
                        <span class="badge bg-success-subtle text-success fw-semibold">
                            Tipo: @Model.ProductType
                        </span>
                    </div>

                    <div class="d-flex align-items-baseline gap-3 mb-3">
                        <span class="fs-3 fw-bold text-success">
                            @Model.Price.ToString("C", culture)
                        </span>
                        @if (Model.DiscountPercent is not null && Model.DiscountPercent > 0)
                        {
                            <span class="badge bg-success">-@Model.DiscountPercent% desc.</span>
                        }
                    </div>

                    <div class="text-muted mb-3">
                        Stock: @(Model.StockCurrent ?? 0)/@(Model.StockMax ?? 0)
                    </div>

                    <div class="mt-auto d-flex gap-2">
                        <form asp-action="AddToCart" asp-controller="Cart" method="post" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="productId" value="@Model.ProdId" />
                            <input type="number" name="qty" value="1" min="1" class="form-control" style="width: 90px;" />
                            <button type="submit" class="btn btn-success" @( (Model.StockCurrent ?? 0) <= 0 ? "disabled" : "" )>
                                <i class="fas fa-cart-plus me-1"></i> Adicionar
                            </button>
                        </form>
                        <a asp-action="Index" class="btn btn-outline-secondary">Continuar a comprar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
