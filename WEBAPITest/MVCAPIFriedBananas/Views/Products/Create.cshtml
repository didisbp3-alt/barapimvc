@model MVCAPIFriedBananas.Views.ViewModels.ProductsViewModel
@{
    ViewData["Title"] = "Adicionar Produto";
    var categories = ViewBag.Categories as List<MVCAPIFriedBananas.Models.Category> ?? new List<MVCAPIFriedBananas.Models.Category>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" />
}

<div class="d-flex justify-content-center align-items-start py-4">
    <div style="max-width:520px; width:100%;">
        <div class="card" style="padding:2rem 2rem 1.5rem; box-shadow:var(--p-card-shadow); border-radius:1.25rem; border:1px solid var(--p-border);">
            <h2 class="mb-3 text-center" style="font-weight:800; color:var(--p-accent);">➕ Adicionar Produto</h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3" style="border-radius:0.75rem;">
                    <ul class="mb-0 ps-3">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Create" method="post" enctype="multipart/form-data" autocomplete="off">
                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Nome</label>
                    <input asp-for="Name" class="form-control" placeholder="Nome do produto" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Descrição</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descrição do produto"></textarea>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col">
                        <label asp-for="Price" class="form-label fw-semibold">Preço (€)</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                    </div>
                    <div class="col">
                        <label asp-for="DiscountPercent" class="form-label fw-semibold">Desconto (%)</label>
                        <input asp-for="DiscountPercent" class="form-control" type="number" min="0" max="100" placeholder="0" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col">
                        <label asp-for="StockCurrent" class="form-label fw-semibold">Stock atual</label>
                        <input asp-for="StockCurrent" class="form-control" type="number" min="0" placeholder="0" />
                    </div>
                    <div class="col">
                        <label asp-for="StockMax" class="form-label fw-semibold">Stock máximo</label>
                        <input asp-for="StockMax" class="form-control" type="number" min="0" placeholder="0" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Cat_Id" class="form-label fw-semibold">Categoria</label>
                    <select asp-for="Cat_Id" class="form-select">
                        <option value="">— Selecionar categoria —</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.CatId">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Cat_Id" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ImageFile" class="form-label fw-semibold">Imagem do produto</label>
                    <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                    <div class="form-text text-muted">Opcional — pode adicionar a imagem agora ou mais tarde.</div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary" style="font-weight:700; height:2.75rem; border-radius:0.875rem;">
                        ➕ Criar produto
                    </button>
                    <a asp-action="AdminIndex" class="btn btn-ghost" style="height:2.75rem; border-radius:0.875rem; display:flex; align-items:center; justify-content:center;">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
