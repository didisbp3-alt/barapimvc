@model MVCAPIFriedBananas.Views.ViewModels.ProductsViewModel
@{
    ViewData["Title"] = "Adicionar Produto";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card" style="max-width: 480px; width: 100%; padding: 2rem 2rem 1.5rem 2rem; box-shadow: var(--shadow); border-radius: var(--radius);">
        <h2 class="mb-3 text-center" style="font-weight:700; color:var(--brand);">Adicionar Produto</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Create" method="post" autocomplete="off">
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Nome do produto" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" placeholder="Descrição"></textarea>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Preço" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="StockMax" class="form-label"></label>
                <input asp-for="StockMax" class="form-control" type="number" placeholder="Stock máximo" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Cat_Id" class="form-label">Categoria</label>
                <input asp-for="Cat_Id" class="form-control" type="number" placeholder="ID da categoria" />
                <!-- Replace with a dropdown if you have categories -->
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-small mb-2" style="font-weight:700;">Adicionar</button>
            <div class="text-center mt-2">
                <a asp-action="Index" class="btn btn-ghost btn-small">Cancelar</a>
            </div>
        </form>
    </div>
</div>

