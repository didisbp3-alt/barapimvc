@model MVCAPIFriedBananas.ViewModels.WeeklyMenuViewModel
@{
    ViewData["Title"] = "Menu Semanal";
    var weekStartValue = Model.WeekStart.ToString("yyyy-MM-dd");
}

@section Styles {
<style>
/* ===== MENU PAGE ===== */
.menu-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 0 3rem;
}

.menu-page-header {
    margin-bottom: 1.5rem;
}

.menu-page-header h1 {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text, #1a1a2e);
    margin-bottom: 0.25rem;
}

.menu-page-header p {
    color: var(--text-muted, #6b7280);
    margin-bottom: 1rem;
}

.week-picker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    padding: 0.875rem 1rem;
    background: var(--card, #fff);
    border: 1px solid var(--border, rgba(232,118,0,0.15));
    border-radius: 0.875rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.week-picker label {
    font-weight: 600;
    color: var(--text, #1a1a2e);
    font-size: 0.9rem;
    white-space: nowrap;
}

.week-picker input[type="date"] {
    height: 2.25rem;
    padding: 0 0.875rem;
    border: 1.5px solid var(--border, rgba(232,118,0,0.20));
    border-radius: 0.625rem;
    background: var(--card, #fff);
    color: var(--text, #1a1a2e);
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color 180ms ease;
}

.week-picker input[type="date"]:focus {
    outline: none;
    border-color: #e87600;
}

/* Days grid */
.menu-days-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
}

/* Day card */
.menu-day-card {
    background: var(--card, #fff);
    border: 1px solid var(--border, rgba(232,118,0,0.15));
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.07);
    transition: transform 200ms ease, box-shadow 200ms ease;
}

.menu-day-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

.menu-day-header {
    background: linear-gradient(135deg, #e87600, #ffb14e);
    padding: 0.875rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.menu-day-name {
    font-size: 0.95rem;
    font-weight: 800;
    color: #fff;
    text-transform: capitalize;
}

.menu-day-date {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.88);
}

.menu-day-body {
    padding: 0;
}

/* Menu type panels */
.menu-type-panel {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border, rgba(232,118,0,0.12));
}

.menu-type-panel:last-child {
    border-bottom: none;
}

.menu-type-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.625rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
}

.menu-type-label.normal {
    background: rgba(232,118,0,0.12);
    color: #c96700;
}

.menu-type-label.vegetariano {
    background: rgba(34,197,94,0.12);
    color: #15803d;
}

.menu-main-dish {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text, #1a1a2e);
    margin-bottom: 0.35rem;
    line-height: 1.3;
}

.menu-details {
    font-size: 0.82rem;
    color: var(--text-muted, #6b7280);
    line-height: 1.5;
    margin-bottom: 0.5rem;
}

.menu-detail-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.menu-detail-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e87600;
    flex-shrink: 0;
}

.menu-notes {
    font-size: 0.78rem;
    color: var(--text-muted, #6b7280);
    font-style: italic;
    margin-bottom: 0.5rem;
}

.menu-seats {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text, #1a1a2e);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.menu-seats-count {
    background: rgba(232,118,0,0.12);
    color: #e87600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-weight: 700;
}

.menu-empty {
    color: var(--text-muted, #6b7280);
    font-size: 0.875rem;
    font-style: italic;
    padding: 0.5rem 0;
}

/* Book button */
.btn-book {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.25rem;
    padding: 0 1rem;
    background: linear-gradient(135deg, #e87600, #ffb14e);
    color: #fff;
    border: none;
    border-radius: 0.625rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 180ms ease;
    box-shadow: 0 3px 10px rgba(232,118,0,0.30);
}

.btn-book:hover {
    box-shadow: 0 5px 16px rgba(232,118,0,0.45);
    transform: translateY(-1px);
}

/* Alerts */
.menu-alert {
    border-radius: 0.875rem;
    padding: 0.875rem 1.25rem;
    margin-bottom: 1.25rem;
    font-weight: 500;
}

.menu-alert.success {
    background: rgba(34,197,94,0.10);
    color: #15803d;
    border: 1px solid rgba(34,197,94,0.20);
}

.menu-alert.danger {
    background: rgba(239,68,68,0.10);
    color: #dc2626;
    border: 1px solid rgba(239,68,68,0.20);
}

@@media (max-width: 640px) {
    .menu-days-grid {
        grid-template-columns: 1fr;
    }
}
</style>
}

<div class="menu-page">
    <div class="menu-page-header">
        <h1>🍽️ Menu Semanal</h1>
        <p>Semana de @Model.WeekStart.ToString("dd MMM yyyy") a @Model.WeekStart.AddDays(6).ToString("dd MMM yyyy")</p>
    </div>

    @if (TempData["BookingMessage"] != null)
    {
        var ok = TempData["BookingSuccess"] as bool? ?? false;
        <div class="menu-alert @(ok ? "success" : "danger")">
            @(ok ? "✅" : "⚠️") @TempData["BookingMessage"]
        </div>
    }

    <form method="get" class="week-picker">
        <label for="weekStart">📅 Semana:</label>
        <input type="date" id="weekStart" name="weekStart" value="@weekStartValue" onchange="this.form.submit()" />
    </form>

    <div class="menu-days-grid">
        @foreach (var day in Model.Days)
        {
            <div class="menu-day-card">
                <div class="menu-day-header">
                    <span class="menu-day-name">@day.Date.ToString("dddd")</span>
                    <span class="menu-day-date">@day.Date.ToString("dd/MM")</span>
                </div>
                <div class="menu-day-body">
                    <!-- Normal -->
                    <div class="menu-type-panel">
                        <div class="menu-type-label normal">🍖 Normal</div>
                        @if (day.Normal != null)
                        {
                            <div class="menu-main-dish">@day.Normal.MainDish</div>
                            <div class="menu-details">
                                <div class="menu-detail-row">
                                    <span class="menu-detail-dot"></span>
                                    Sopa: @day.Normal.Soup
                                </div>
                                <div class="menu-detail-row">
                                    <span class="menu-detail-dot"></span>
                                    Sobremesa: @day.Normal.Dessert
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(day.Normal.Notes))
                            {
                                <div class="menu-notes">ℹ️ @day.Normal.Notes</div>
                            }
                            <div class="menu-seats">
                                Vagas: <span class="menu-seats-count">@day.Normal.AvailableSeats</span>
                            </div>
                            <form method="post" asp-controller="Booking" asp-action="Book" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="menuId" value="@day.Normal.MId" />
                                <input type="hidden" name="weekStart" value="@weekStartValue" />
                                <button type="submit" class="btn-book">📅 Marcar</button>
                            </form>
                        }
                        else
                        {
                            <div class="menu-empty">Sem menu disponível</div>
                        }
                    </div>

                    <!-- Vegetariano -->
                    <div class="menu-type-panel">
                        <div class="menu-type-label vegetariano">🥗 Vegetariano</div>
                        @if (day.Vegetarian != null)
                        {
                            <div class="menu-main-dish">@day.Vegetarian.MainDish</div>
                            <div class="menu-details">
                                <div class="menu-detail-row">
                                    <span class="menu-detail-dot"></span>
                                    Sopa: @day.Vegetarian.Soup
                                </div>
                                <div class="menu-detail-row">
                                    <span class="menu-detail-dot"></span>
                                    Sobremesa: @day.Vegetarian.Dessert
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(day.Vegetarian.Notes))
                            {
                                <div class="menu-notes">ℹ️ @day.Vegetarian.Notes</div>
                            }
                            <div class="menu-seats">
                                Vagas: <span class="menu-seats-count">@day.Vegetarian.AvailableSeats</span>
                            </div>
                            <form method="post" asp-controller="Booking" asp-action="Book" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="menuId" value="@day.Vegetarian.MId" />
                                <input type="hidden" name="weekStart" value="@weekStartValue" />
                                <button type="submit" class="btn-book">📅 Marcar</button>
                            </form>
                        }
                        else
                        {
                            <div class="menu-empty">Sem menu disponível</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
