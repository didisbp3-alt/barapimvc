@model MVCAPIFriedBananas.Views.ViewModels.MenuDayViewModel
@{
    ViewData["Title"] = "Editar Dia de Menu";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card" style="max-width: 420px; width: 100%; padding: 2rem;">
        <h2 class="mb-3 text-center" style="font-weight:700; color:var(--brand);">Editar Dia de Menu</h2>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
        <form asp-action="EditDay" method="post" autocomplete="off">
            <div class="form-group mb-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" class="form-control" type="date" />
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-small mb-2" style="font-weight:700;">Guardar</button>
            <div class="text-center mt-2">
                <a asp-action="AdminIndex" class="btn btn-ghost btn-small">Cancelar</a>
            </div>
        </form>
    </div>
</div>
