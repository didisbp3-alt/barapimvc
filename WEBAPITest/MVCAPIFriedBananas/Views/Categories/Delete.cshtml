@model MVCAPIFriedBananas.Models.Category
@{
    ViewData["Title"] = "Eliminar Categoria";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card" style="max-width: 420px; width: 100%; padding: 2rem 2rem 1.5rem 2rem; box-shadow: var(--shadow); border-radius: var(--radius);">
        <h2 class="mb-3 text-center" style="font-weight:700; color:var(--brand);">Eliminar Categoria</h2>
        <div class="mb-3 text-center">
            <strong>@Model.Name</strong>
            <div class="muted">ID: @Model.CatId</div>
            <div class="mt-2">Tem certeza que deseja eliminar esta categoria?</div>
        </div>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="CatId" />
            <button type="submit" class="btn btn-danger btn-small w-100 mb-2" style="font-weight:700;">Eliminar</button>
            <div class="text-center mt-2">
                <a asp-action="Index" class="btn btn-ghost btn-small">Cancelar</a>
            </div>
        </form>
    </div>
</div>

