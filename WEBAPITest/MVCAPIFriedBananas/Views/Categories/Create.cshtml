@model MVCAPIFriedBananas.Models.Category
@{
    ViewData["Title"] = "Nova Categoria";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card" style="max-width: 420px; width: 100%; padding: 2rem 2rem 1.5rem 2rem; box-shadow: var(--shadow); border-radius: var(--radius);">
        <h2 class="mb-3 text-center" style="font-weight:700; color:var(--brand);">Nova Categoria</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Create" method="post" autocomplete="off">
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Nome da categoria" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-small mb-2" style="font-weight:700;">Guardar</button>
            <div class="text-center mt-2">
                <a asp-action="Index" class="btn btn-ghost btn-small">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
