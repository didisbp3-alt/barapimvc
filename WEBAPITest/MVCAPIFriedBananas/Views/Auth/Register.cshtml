@model MVCAPIFriedBananas.Models.RegisterModel

@{
    ViewData["Title"] = "Registro";
}

<div class="login-page">
    <div class="login-card">

        <div class="login-header">
            <h1>Criar Conta</h1>
            <p>Acesso à plataforma</p>
        </div>

        <div class="login-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Register" method="post" autocomplete="off">

                <div class="login-field">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" placeholder="Nome completo" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="Seu email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" placeholder="Senha" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Registar
                </button>

                <div class="login-footer">
                    <p>Já tem conta?</p>
                    <a asp-action="Login" class="btn btn-ghost login-register-btn">
                        Entrar
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>

    

    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
        padding-top: 10vh;
    }

    
    .login-card {
        width: 100%;
        max-width: 420px;
        background: var(--card);
        border-radius: 1.75rem;
        box-shadow: 0 30px 60px rgba(0,0,0,0.18);
    }

    
    .login-header {
        text-align: center;
        padding: 3rem 2.5rem 1.5rem;
    }

        .login-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--brand);
            margin-bottom: 0.25rem;
        }

        .login-header p {
            color: var(--text-muted);
        }

    
    .login-body {
        padding: 2.5rem;
    }

    
    .login-field {
        margin-bottom: 1.75rem;
    }

        .login-field label {
            font-weight: 700;
            display: block;
            margin-bottom: 0.5rem;
        }

        .login-field input {
            width: 100%;
            height: 3.1rem;
            padding: 0.6rem 1.25rem;
            font-size: 0.95rem;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: var(--card);
            box-shadow: 0 6px 14px rgba(0,0,0,0.06);
            outline: none;
        }

            .login-field input:focus {
                border-color: var(--brand);
                box-shadow: 0 0 0 4px rgba(232,118,0,0.2);
            }

    
    .login-body .btn-primary {
        width: 100%;
        height: 3.9rem;
        border-radius: 999px;
        font-size: 1.1rem;
        margin-top: 0.5rem;
    }

    
    .login-footer {
        margin-top: 2.25rem;
        text-align: center;
    }

        .login-footer p {
            margin-bottom: 0.75rem;
            color: var(--text-muted);
            font-weight: 500;
        }

    
    .login-register-btn {
        border-radius: 999px;
        padding: 0.55rem 1.5rem;
        font-size: 0.9rem;
    }

    
    .login-body .alert {
        border-radius: 999px;
        text-align: center;
    }

</style>

