@model IEnumerable<MVCAPIFriedBananas.Models.UserAdminDto>
@{
    ViewData["Title"] = "Gestão de Utilizadores";

    string RoleName(int? role) => role switch
    {
        0 => "Administrador",
        1 => "Funcionário / Bar",
        2 => "Aluno",
        _ => "Utilizador"
    };
}

<div class="container mt-4">
    <h2 class="mb-4" style="font-weight:700; color:var(--brand);">Gestão de Utilizadores</h2>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Tipo</th>
                    <th>Saldo</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UId</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td><span class="badge bg-info">@RoleName(user.Role)</span></td>
                        <td>@((user.Balance ?? 0).ToString("C2"))</td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@user.UId" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

